# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and set your private credentials and configuration.
# NEVER commit your actual '.env' file to GitHub!
# =============================================================================

# Master Admin Credentials
MASTER_USERNAME=your_master_username
MASTER_PASSWORD=your_master_password
MASTER_DISPLAY_NAME=Master Admin

# Admin Portal Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=Shift Admin

# GitHub Releases & Cloud Storage Credentials
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repository
GITHUB_DATA_BRANCH=data-store

# Optional Cloud / CDN Keys
CDN_API_KEY=your_cdn_api_key_here
CLOUD_API_KEY=your_cloud_api_key_here

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
